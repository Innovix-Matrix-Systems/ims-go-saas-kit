---
// The theme picker: a small button that opens a menu (System, Light, Dark)
// instead of Starlight's native <select>. It keeps Starlight's storage
// ('starlight-theme' in localStorage, '' = follow the system) and the
// data-theme attribute on <html>, so everything else on the site still works.
import { Icon } from '@astrojs/starlight/components'

const options = [
  { value: 'auto', label: 'System', icon: 'laptop' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' },
] as const
---

<ims-theme-select>
  <button type="button" class="trigger" aria-haspopup="menu" aria-expanded="false" aria-label="Theme: System">
    {options.map((o) => <Icon name={o.icon} class={`trigger-icon icon-${o.value}`} />)}
    <span class="trigger-label">System</span>
    <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
  <ul class="menu" role="menu" aria-label="Theme" hidden>
    {
      options.map((o) => (
        <li role="none">
          <button type="button" role="menuitemradio" aria-checked="false" data-value={o.value} tabindex="-1">
            <Icon name={o.icon} class="item-icon" />
            <span>{o.label}</span>
            <svg class="check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
        </li>
      ))
    }
  </ul>
</ims-theme-select>

{/* Show the stored choice before first paint, so the button never flickers. */}
<script is:inline>
  ;(() => {
    const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme')
    const theme = stored === 'light' || stored === 'dark' ? stored : 'auto'
    const labels = { auto: 'System', light: 'Light', dark: 'Dark' }
    document.querySelectorAll('ims-theme-select').forEach((el) => {
      el.dataset.choice = theme
      const label = el.querySelector('.trigger-label')
      if (label) label.textContent = labels[theme]
    })
  })()
</script>

<script>
  type Theme = 'auto' | 'light' | 'dark'
  const storageKey = 'starlight-theme'
  const labels: Record<Theme, string> = { auto: 'System', light: 'Light', dark: 'Dark' }

  const parse = (value: unknown): Theme => (value === 'light' || value === 'dark' ? value : 'auto')
  const load = (): Theme => {
    try {
      return parse(localStorage.getItem(storageKey))
    } catch {
      return 'auto'
    }
  }
  const systemTheme = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')

  function apply(theme: Theme): void {
    document.documentElement.dataset.theme = theme === 'auto' ? systemTheme() : theme
    try {
      localStorage.setItem(storageKey, theme === 'auto' ? '' : theme)
    } catch {
      /* storage disabled: the choice lasts for this page */
    }
    document.querySelectorAll<ThemeSelect>('ims-theme-select').forEach((el) => el.show(theme))
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (load() === 'auto') apply('auto')
  })

  class ThemeSelect extends HTMLElement {
    private trigger!: HTMLButtonElement
    private menu!: HTMLUListElement
    private items!: HTMLButtonElement[]

    connectedCallback() {
      this.trigger = this.querySelector('.trigger')!
      this.menu = this.querySelector('.menu')!
      this.items = [...this.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]')]
      this.show(load())

      this.trigger.addEventListener('click', () => (this.menu.hidden ? this.open() : this.close()))
      this.trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault()
          this.open()
        }
      })
      for (const item of this.items) {
        item.addEventListener('click', () => {
          apply(parse(item.dataset.value))
          this.close(true)
        })
      }
      this.menu.addEventListener('keydown', (e) => this.onMenuKey(e))
      document.addEventListener('pointerdown', (e) => {
        if (!this.menu.hidden && !this.contains(e.target as Node)) this.close()
      })
      this.addEventListener('focusout', (e) => {
        if (!this.menu.hidden && !this.contains(e.relatedTarget as Node)) this.close()
      })
    }

    show(theme: Theme) {
      this.dataset.choice = theme
      this.querySelector('.trigger-label')!.textContent = labels[theme]
      this.trigger?.setAttribute('aria-label', `Theme: ${labels[theme]}`)
      for (const item of this.items ?? []) item.setAttribute('aria-checked', String(item.dataset.value === theme))
    }

    open() {
      // Open upwards when there is no room below (the phone menu's footer).
      const rect = this.trigger.getBoundingClientRect()
      this.classList.toggle('up', window.innerHeight - rect.bottom < 160 && rect.top > 160)
      this.menu.hidden = false
      this.trigger.setAttribute('aria-expanded', 'true')
      const current = this.items.find((i) => i.getAttribute('aria-checked') === 'true') ?? this.items[0]
      current.focus()
    }

    close(refocus = false) {
      this.menu.hidden = true
      this.trigger.setAttribute('aria-expanded', 'false')
      if (refocus) this.trigger.focus()
    }

    onMenuKey(e: KeyboardEvent) {
      const index = this.items.indexOf(document.activeElement as HTMLButtonElement)
      const move = (to: number) => this.items[(to + this.items.length) % this.items.length].focus()
      if (e.key === 'ArrowDown') move(index + 1)
      else if (e.key === 'ArrowUp') move(index - 1)
      else if (e.key === 'Home') move(0)
      else if (e.key === 'End') move(this.items.length - 1)
      else if (e.key === 'Escape' || e.key === 'Tab') {
        if (e.key === 'Escape') this.close(true)
        else this.close()
        return
      } else return
      e.preventDefault()
    }
  }
  customElements.define('ims-theme-select', ThemeSelect)
</script>

<style>
  ims-theme-select {
    position: relative;
    display: inline-flex;
  }
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.55rem 0 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: 500 var(--sl-text-sm) var(--sl-font);
    cursor: pointer;
    transition: border-color 0.12s, color 0.12s;
  }
  .trigger:hover,
  .trigger[aria-expanded='true'] {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
  .trigger:focus-visible,
  .menu button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .trigger :global(.trigger-icon) {
    display: none;
    font-size: 1rem;
  }
  ims-theme-select[data-choice='auto'] .trigger :global(.icon-auto),
  ims-theme-select[data-choice='light'] .trigger :global(.icon-light),
  ims-theme-select[data-choice='dark'] .trigger :global(.icon-dark),
  ims-theme-select:not([data-choice]) .trigger :global(.icon-auto) {
    display: inline-block;
  }
  .chevron {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--sl-color-gray-3);
    transition: transform 0.15s;
  }
  .trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 30;
    min-width: 9rem;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    box-shadow:
      0 12px 32px -12px rgba(0, 0, 0, 0.35),
      0 2px 6px rgba(0, 0, 0, 0.08);
  }
  ims-theme-select.up .menu {
    top: auto;
    bottom: calc(100% + 0.35rem);
  }
  .menu li {
    margin: 0;
  }
  .menu button {
    display: grid;
    grid-template-columns: 1rem 1fr 1rem;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.45rem 0.55rem;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--sl-color-gray-2);
    font: var(--sl-text-sm) var(--sl-font);
    text-align: start;
    cursor: pointer;
  }
  .menu button:hover,
  .menu button:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .menu button[aria-checked='true'] {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .menu :global(.item-icon) {
    font-size: 1rem;
  }
  .check {
    width: 1rem;
    height: 1rem;
    color: var(--sl-color-accent);
    visibility: hidden;
  }
  .menu button[aria-checked='true'] .check {
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .trigger,
    .chevron {
      transition: none;
    }
  }
</style>
