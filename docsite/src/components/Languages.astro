---
// The app in other languages: Arabic (right to left) and Bangla, to show that the
// whole app (and the API's messages and e-mails) is translated, not only its
// menus.
import { Image } from 'astro:assets'
import homeAr from '../../../docs/images/app-org-dashboard-ar.png'
import billingBn from '../../../docs/images/app-billing-bn.png'
---

<section class="band not-content" aria-labelledby="languages-title">
  <div class="copy">
    <h2 id="languages-title">Every screen, in your customers' language</h2>
    <p>
      Six languages out of the box: English, Bangla, German, Arabic (right to left), Spanish and
      French. Menus, charts, dates, numerals and prices, the API's messages, notifications and
      e-mails, each in the reader's language. A new language is a descriptor and catalog files, no
      code, and the checks fail until every key is translated.
    </p>
    <a href="/guides/languages/">Languages →</a>
  </div>
  <div class="shots">
    <span class="shot rtl">
      <Image src={homeAr} alt="The organization home in Arabic, laid out right to left" widths={[560, 1120]} sizes="(min-width: 64rem) 380px, 92vw" />
    </span>
    <span class="shot">
      <Image src={billingBn} alt="The billing page in Bangla" widths={[560, 1120]} sizes="(min-width: 64rem) 380px, 92vw" />
    </span>
  </div>
</section>

<style>
  .band {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
  }
  h2 {
    margin: 0;
    font-family: var(--ims-font-display);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 700;
    color: var(--sl-color-white);
    letter-spacing: -0.015em;
  }
  p {
    margin: 0;
    color: var(--sl-color-gray-3);
    max-width: 46ch;
  }
  a {
    font: 0.8rem var(--sl-font-mono);
    color: var(--sl-color-accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }
  .shot {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    display: block;
  }
  /* A right-to-left screen starts at the right edge: keep its sidebar. */
  .shot.rtl :global(img) {
    object-position: top right;
  }
  @media (min-width: 64rem) {
    .band {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 2.5rem;
    }
  }
  @media (max-width: 30rem) {
    .shots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
