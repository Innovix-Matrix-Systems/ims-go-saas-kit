---
// Starlight's site title plus the release this documentation describes
// (read from the repository's VERSION file).
import Default from '@astrojs/starlight/components/SiteTitle.astro'
import versionFile from '../../../VERSION?raw'

const version = versionFile.trim()
---

<div class="site-title-wrap">
  <Default {...Astro.props}><slot /></Default>
  <a class="version-badge" href="/operations/releases/" title="Documentation for this release">v{version}</a>
</div>

<style>
  .site-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .version-badge {
    text-decoration: none;
  }
</style>
