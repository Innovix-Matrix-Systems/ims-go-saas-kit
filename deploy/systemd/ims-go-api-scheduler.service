[Unit]
Description=IMS Go API (cron scheduler)
Documentation=https://github.com/Innovix-Matrix-Systems/ims-go-api-starter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ims
Group=ims
WorkingDirectory=/opt/ims/ims-go-api/current
EnvironmentFile=/etc/ims/ims-go-api/.env
ExecStart=/opt/ims/ims-go-api/current/ims schedule
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM

# Exactly one scheduler must run per deployment (see docs/runbooks/deploy.md).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ims/ims-go-api /var/log/ims/ims-go-api

[Install]
WantedBy=multi-user.target
