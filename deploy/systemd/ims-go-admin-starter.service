[Unit]
Description=IMS Go Admin Starter (HTTP server)
Documentation=https://github.com/Innovix-Matrix-Systems/ims-go-admin-starter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ims
Group=ims
WorkingDirectory=/opt/ims/ims-go-admin-starter/current
EnvironmentFile=/etc/ims/ims-go-admin-starter/.env
ExecStart=/opt/ims/ims-go-admin-starter/current/ims serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
KillSignal=SIGTERM

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ims/ims-go-admin-starter /var/log/ims/ims-go-admin-starter
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
