[Unit]
Description=IMS Go SaaS Kit (cron scheduler)
Documentation=https://github.com/Innovix-Matrix-Systems/ims-go-saas-kit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ims
Group=ims
WorkingDirectory=/opt/ims/ims-go-saas-kit/current
EnvironmentFile=/etc/ims/ims-go-saas-kit/.env
ExecStart=/opt/ims/ims-go-saas-kit/current/ims schedule
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM

# Exactly one scheduler must run per deployment (see docs/runbooks/deploy.md).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ims/ims-go-saas-kit /var/log/ims/ims-go-saas-kit

[Install]
WantedBy=multi-user.target
