[Unit]
Description=IMS Go API (queue worker)
Documentation=https://github.com/Innovix-Matrix-Systems/ims-go-api-starter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ims
Group=ims
WorkingDirectory=/opt/ims/ims-go-api/current
EnvironmentFile=/etc/ims/ims-go-api/.env
ExecStart=/opt/ims/ims-go-api/current/ims queue:work --queues=critical,default,heavy
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=1800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ims/ims-go-api /var/log/ims/ims-go-api

[Install]
WantedBy=multi-user.target
