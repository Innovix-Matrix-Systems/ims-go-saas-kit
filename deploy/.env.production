# ── ims-go-saas-kit production environment template ──────────────
# Copy to /etc/ims/ims-go-saas-kit/.env and fill in every value marked MUST SET.
# This template is fail-safe by default: no known credentials, no dev
# dashboard, no docs, expiring tokens, JSON logs. The installer
# (deploy/scripts/install.sh) copies .env.example only as a LAST RESORT for
# local development — production provisioning should start from this file.

# ── App ─────────────────────────────────────────────
APP_ENV=production
APP_NAME=ims-go-saas-kit
APP_DEBUG=false
APP_URL=http://localhost:8080            # MUST SET: public base URL
APP_KEY=                                 # MUST SET: `ims key:generate` (encrypts two-factor secrets)
# APP_PREVIOUS_KEYS=                     # old keys still accepted while rotating (comma-separated)
APP_LISTEN_ADDR=:8080
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,bn
APP_LOG_LEVEL=info
APP_LOG_DIR=                             # empty → stdout (journald)
APP_DATA_DIR=/var/lib/ims/ims-go-saas-kit
APP_STORAGE_DIR=/var/lib/ims/ims-go-saas-kit/storage
APP_CACHE_DIR=/var/lib/ims/ims-go-saas-kit/cache

# ── HTTP ────────────────────────────────────────────
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=90s                   # > HTTP_REQUEST_TIMEOUT (raised automatically if not)
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_REQUEST_TIMEOUT=60s
HTTP_MAX_REQUEST_BODY_BYTES=10485760
HTTP_STRICT_JSON_FIELDS=true
# HTTP_TRUSTED_PROXIES=127.0.0.1          # MUST SET behind nginx/a proxy: the proxy peers
RATE_LIMIT_PER_MINUTE=1000

# ── Database ──────────────────────────────
DATABASE_DRIVER=pgsql
DATABASE_DSN=                            # MUST SET; use sslmode=prefer or stricter
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_CONN_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=5m
DATABASE_IDLE_IN_TX_TIMEOUT=1m

# ── Cache ─────────────────────────────────
CACHE_DRIVER=database                    # database works out of the box; prefer redis with replicas
CACHE_PREFIX=ims-
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Queue ─────────────────────────────────
QUEUE_DRIVER=river
QUEUE_CRITICAL_TRIES=3
QUEUE_CRITICAL_TIMEOUT=60
QUEUE_DEFAULT_TRIES=5
QUEUE_DEFAULT_TIMEOUT=120
QUEUE_HEAVY_TRIES=1
QUEUE_HEAVY_TIMEOUT=1800
QUEUE_WORKER_CONCURRENCY=10

# ── Scheduler ─────────────────────────────
SCHEDULE_TIMEZONE=Asia/Dhaka             # exactly ONE schedule process per deployment
# SCHEDULE_HISTORY_DAYS=30

# ── Auth ──────────────────────────────────
AUTH_TOKEN_EXPIRATION=1440               # minutes (24 h); 0 is refused in production
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=1
AUTH_OTP_ENABLED=false
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRY_MINUTES=5
AUTH_DEFAULT_PASSWORD=                   # MUST SET (or run db:seed --force to auto-generate)
AUTH_PASSWORD_RESET_URL=                 # MUST SET to your client app page, e.g. https://app.example.com/reset-password?token={token}&email={email}
AUTH_EMAIL_VERIFY_URL=                   # e.g. https://app.example.com/verify-email?token={token}
BCRYPT_ROUNDS=12

# ── Tenancy ───────────────────────────────
DEFAULT_TENANT_ID=1
DEFAULT_TENANT_NAME=Main Tenant
DEFAULT_TENANT_CODE=                     # MUST SET: a fresh random code per installation
DEFAULT_TENANT_SLUG=main-tenant
DEFAULT_TENANT_IS_ACTIVE=true
DEFAULT_BRANCH_ID=1
DEFAULT_BRANCH_NAME=Default Branch

# ── Billing ───────────────────────────────
# The currency is not configured here: staff choose it in the console (Currencies).
# BKASH_BASE_URL= / BKASH_APP_KEY= / BKASH_APP_SECRET= / BKASH_USERNAME= / BKASH_PASSWORD=
# BANK_TRANSFER_ACCOUNT_NAME= / BANK_TRANSFER_ACCOUNT_NUMBER= / BANK_TRANSFER_BANK_NAME= / BANK_TRANSFER_BRANCH=

# ── Mail ──────────────────────────────────
MAIL_DRIVER=log                          # set to smtp and configure for real deliveries
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=                       # MUST SET
MAIL_FROM_NAME=IMS Go SaaS Kit

# ── SMS (delivery system) ─────────────────
SMS_DRIVER=log                           # set to twilio for real SMS
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=
# DELIVERY_RETENTION_DAYS=30

# ── Files & storage ───────────────────────
FILES_DISK=private                       # any disk: private (download route) | public | s3 | STORAGE_DISKS name
# FILES_PUBLIC_DISK=public                 # avatars when FILES_DISK is private
STORAGE_PUBLIC_DIR=/var/lib/ims/ims-go-saas-kit/storage/public
STORAGE_PRIVATE_DIR=/var/lib/ims/ims-go-saas-kit/storage/private
DATA_PROCESSING_DISK=private
DATA_PROCESSING_BASE_PATH=jobs
# S3_ENDPOINT= / S3_REGION= / S3_BUCKET= / S3_ACCESS_KEY= / S3_SECRET_KEY=
# S3_PUBLIC_URL= / S3_ROOT= / S3_VISIBILITY=
# More disks (R2, MinIO, ...): STORAGE_DISKS=r2 + STORAGE_R2_* (see .env.example)

# ── Ops & security ────────────────────────
DOCS_ENABLED=false
METRICS_ENABLED=false
# METRICS_TOKEN=                         # bearer token for /metrics (unset = loopback only)
# OTEL_EXPORTER_OTLP_ENDPOINT=           # OpenTelemetry traces (OTLP/HTTP); set = on
# OTEL_EXPORTER_OTLP_HEADERS=            # backend auth, e.g. x-honeycomb-team=KEY
SECURITY_HEADERS_ENABLED=true
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Developer dashboard ───────────────────
DEV_DASHBOARD_ENABLED=false              # keep off in production; enable deliberately if needed

# ── Database backups ──────────────────────
BACKUP_ENABLED=true
BACKUP_DIR=/var/lib/ims/ims-go-saas-kit/backups
BACKUP_DESTINATIONS=local                # add s3 for off-machine copies
BACKUP_KEEP_ALL_DAYS=7
BACKUP_MAX_TOTAL_MB=0
