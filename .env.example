# ── App ─────────────────────────────────────────────
APP_ENV=local
APP_NAME=ims-go-admin-starter
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=                                  # `ims key:generate`; empty locally = a public dev key
# APP_PREVIOUS_KEYS=                      # old keys still accepted while rotating (comma-separated)
APP_LISTEN_ADDR=:8080
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,bn
APP_LOG_LEVEL=info
APP_DATA_DIR=./var
APP_STORAGE_DIR=./var/storage
APP_CACHE_DIR=./var/cache
# APP_LOG_DIR=                # empty → stdout (journald in production)
# APP_ENV_FILE=./.env

# ── HTTP ────────────────────────────────────────────
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=90s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_REQUEST_TIMEOUT=60s
HTTP_MAX_REQUEST_BODY_BYTES=10485760
HTTP_STRICT_JSON_FIELDS=true
# HTTP_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8   # honour X-Forwarded-For only from these peers
RATE_LIMIT_PER_MINUTE=1000

# ── Database ──────────────────────────────
DATABASE_DRIVER=pgsql                     # pgsql (v1 is PostgreSQL-only)
DATABASE_DSN=postgres://postgres:postgres@127.0.0.1:5432/ims_go_api?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_CONN_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=5m             # server-side query backstop (0 = off; raise for huge migrations)
DATABASE_IDLE_IN_TX_TIMEOUT=1m            # kills sessions idling inside an open transaction
# Named extra connections (optional):
# DATABASE_CONNECTIONS=primary,analytics
# DATABASE_ANALYTICS_DRIVER=pgsql
# DATABASE_ANALYTICS_DSN=
# Integration tests (dedicated throwaway database):
# DATABASE_TEST_DSN=postgres://postgres:postgres@127.0.0.1:5432/ims_go_api_test?sslmode=disable

# ── Cache ─────────────────────────────────
CACHE_DRIVER=memory                       # memory | file | redis | database
CACHE_PREFIX=ims-
# CACHE_FILE_DIR=./var/cache
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Queue ─────────────────────────────────
QUEUE_DRIVER=river                        # river | sync
QUEUE_CRITICAL_TRIES=3
QUEUE_CRITICAL_TIMEOUT=60
QUEUE_DEFAULT_TRIES=5
QUEUE_DEFAULT_TIMEOUT=120
QUEUE_HEAVY_TRIES=1
QUEUE_HEAVY_TIMEOUT=1800
QUEUE_WORKER_CONCURRENCY=10

# ── Scheduler ─────────────────────────────
SCHEDULE_TIMEZONE=Asia/Dhaka
# SCHEDULE_HISTORY_DAYS=30               # scheduler run history (dashboard); 0 = keep forever

# ── Auth ──────────────────────────────────
AUTH_TOKEN_EXPIRATION=1440                # minutes; 0 = never (refused in production)
# AUTH_SESSION_IDLE_DAYS=0                # sign out sessions unused this long (0 = never)
# AUTH_REQUIRE_2FA_PLATFORM=false         # platform accounts must turn on two-factor
# DEDUPE_ENABLED=true                     # refuse a write sent twice (409 DUPLICATE_REQUEST)
# DEDUPE_WINDOW=3s                        # how long after success a repeat is refused
# IDEMPOTENCY_TTL=24h                     # how long an Idempotency-Key answer is replayed
# WEBHOOK_ALLOW_PRIVATE=                  # endpoints on private/loopback addresses and http (default: local only)
# WEBHOOK_TIMEOUT=10s                     # one delivery attempt
# WEBHOOK_DISABLE_AFTER=5                 # abandoned deliveries in a row before an endpoint is disabled
# WEBHOOK_RETENTION_DAYS=30               # delivery log; 0 = keep forever
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=1
AUTH_OTP_ENABLED=false
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRY_MINUTES=5
AUTH_DEFAULT_PASSWORD=123456
AUTH_CHECK_IS_ACTIVE=true                 # inactive users cannot log in
AUTH_CHECK_EMAIL_VERIFIED=true            # unverified e-mail cannot log in
AUTH_CHECK_PHONE_VERIFIED=false
AUTH_NEW_USERS_VERIFIED=true              # false = admin-created/imported users must verify their e-mail
AUTH_PASSWORD_RESET_EXPIRY=60m
AUTH_EMAIL_VERIFY_EXPIRY=24h
# AUTH_PASSWORD_RESET_URL=https://app.example.com/reset-password?token={token}&email={email}
# AUTH_EMAIL_VERIFY_URL=https://app.example.com/verify-email?token={token}
# AUTH_INVITATION_URL=https://app.example.com/accept-invitation?token={token}&email={email}
# AUTH_INVITATION_TTL=168h                # how long an invitation link works
BCRYPT_ROUNDS=12

# ── Social login ──────────────────────────
# Sign in existing users by the e-mail Google or GitHub verified (docs/guides/social-login.md).
SOCIAL_PROVIDERS=                         # e.g. google,github (empty = off)
# SOCIAL_GOOGLE_CLIENT_IDS=               # web, iOS and Android client ids an id_token may be issued to
# SOCIAL_GITHUB_CLIENT_ID=
# SOCIAL_GITHUB_CLIENT_SECRET=

# ── Tenancy ───────────────────────────────
DEFAULT_TENANT_ID=1
DEFAULT_TENANT_NAME=Main Tenant
DEFAULT_TENANT_CODE=fad58de7366495db4650cfefac2fcd61
DEFAULT_TENANT_SLUG=main-tenant
DEFAULT_TENANT_IS_ACTIVE=true
DEFAULT_TENANT_EMAIL=tenant@example.com
DEFAULT_TENANT_PHONE=
DEFAULT_BRANCH_ID=1
DEFAULT_BRANCH_NAME=Default Branch

# ── Billing ───────────────────────────────
BILLING_CURRENCY=BDT
# BILLING_SUSPEND_ON_EXPIRY=false          # suspend tenants whose subscription expired (nothing current or pending)
# BILLING_SUSPEND_GRACE_DAYS=3            # days after expiry before the suspension
# BKASH_BASE_URL= / BKASH_APP_KEY= / BKASH_APP_SECRET= / BKASH_USERNAME= / BKASH_PASSWORD=
# BKASH_CALLBACK_URL=https://api.example.com/api/v1/billing/bkash/callback
# NAGAD_BASE_URL= / NAGAD_MERCHANT_ID= / NAGAD_MERCHANT_NUMBER= / NAGAD_PUBLIC_KEY= / NAGAD_PRIVATE_KEY=
# BANK_TRANSFER_ACCOUNT_NAME= / BANK_TRANSFER_ACCOUNT_NUMBER= / BANK_TRANSFER_BANK_NAME= / BANK_TRANSFER_BRANCH=

# ── Mail ──────────────────────────────────
MAIL_DRIVER=log                           # log | smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025                            # Mailpit locally
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=                          # tls | starttls | "" (plain)
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=IMS Go Admin Starter
# MAIL_MAX_ATTACHMENT_MB=10                # total attachments per mail
SMS_DRIVER=log                            # log | twilio
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=
# SMS_DAILY_LIMIT_PER_TENANT=500          # notification SMS per tenant per day (0 = no cap)
# DELIVERY_RETENTION_DAYS=30              # delivery log (mail, SMS, push); 0 = keep forever

# ── Files & storage ───────────────────────
# Disks work like Laravel's config/filesystems.php: code only names a disk, so
# moving uploads to S3 / Cloudflare R2 / MinIO is a change of FILES_DISK.
# Built-in disks: private (local, served by the app), public (local, served at
# /storage) and s3 (when S3_* is set). Private disks never get direct URLs.
FILES_DISK=public                         # any disk name: private | public | s3 | <STORAGE_DISKS name>
# FILES_PUBLIC_DISK=public                # where avatars go when FILES_DISK is private (must be public)
# STORAGE_PUBLIC_DIR=./var/storage/public
# STORAGE_PRIVATE_DIR=./var/storage/private
DATA_PROCESSING_DISK=private              # any disk name
DATA_PROCESSING_BASE_PATH=jobs
# The built-in "s3" disk (AWS S3 or any S3-compatible service):
# S3_ENDPOINT=                            # empty for AWS; set for R2/MinIO/Spaces/B2
# S3_REGION=                              # e.g. ap-southeast-1; "auto" for R2
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=false                     # true for MinIO
# S3_PUBLIC_URL=                          # public base URL (CDN); empty → presigned GETs
# S3_ROOT=                                # optional key prefix inside the bucket
# S3_VISIBILITY=                          # public | private (default: public when S3_PUBLIC_URL is set)
#
# More disks: list names in STORAGE_DISKS and set STORAGE_<NAME>_* for each
# (DRIVER=s3|local, ENDPOINT, REGION, BUCKET, ACCESS_KEY, SECRET_KEY,
# PATH_STYLE, PUBLIC_URL, ROOT, VISIBILITY; local disks use ROOT and URL).
# STORAGE_DISKS=r2,minio
# STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_R2_BUCKET=uploads
# STORAGE_R2_ACCESS_KEY=
# STORAGE_R2_SECRET_KEY=
# STORAGE_R2_PUBLIC_URL=https://files.example.com   # R2 custom domain → public disk
# STORAGE_MINIO_ENDPOINT=http://127.0.0.1:9000
# STORAGE_MINIO_BUCKET=uploads
# STORAGE_MINIO_ACCESS_KEY=
# STORAGE_MINIO_SECRET_KEY=
# STORAGE_MINIO_PATH_STYLE=true
# FILES_DISK=r2

# ── Ops & security ────────────────────────
DOCS_ENABLED=                             # Scalar API docs at /docs (default: on outside production)
METRICS_ENABLED=false                     # Prometheus metrics at /metrics
# METRICS_TOKEN=                          # bearer token for /metrics (unset = loopback only)
# OTEL_EXPORTER_OTLP_ENDPOINT=            # OpenTelemetry traces over OTLP/HTTP, e.g. http://localhost:4318 (set = tracing on)
# OTEL_EXPORTER_OTLP_HEADERS=             # backend auth, e.g. x-honeycomb-team=KEY or Authorization=Basic%20…
# OTEL_TRACES_SAMPLER_ARG=0.1             # share of new traces kept (parent-based; a caller's sampled trace is always kept)
# OTEL_SERVICE_NAME=                      # default: APP_NAME
# OTEL_SDK_DISABLED=false                 # true turns tracing off even with an endpoint set
# CACHE_MEMORY_MAX_ENTRIES=100000         # memory cache driver bound
SECURITY_HEADERS_ENABLED=true             # baseline hardening response headers
# CORS_ALLOWED_ORIGINS=                   # comma-separated; empty disables CORS entirely
# CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Accept-Language,X-Acting-Tenant,X-Acting-Branch,X-Acting-User,X-Tenant-Code,X-Branch-Id,X-Request-Id,X-Maintenance-Bypass,Idempotency-Key,traceparent,tracestate
# CORS_MAX_AGE=600                        # seconds
# MAINTENANCE_CHECK_INTERVAL=5s           # how often each process re-reads the maintenance state (ims down/up)

# ── Developer dashboard ───────────────────
DEV_DASHBOARD_ENABLED=                    # /dev SPA + /dev/api (default: on outside production)
# DEV_DASHBOARD_CAPTURE=http,sql,cache,queue,logs
# DEV_DASHBOARD_SAMPLE_RATE=1.0           # 0..1 telemetry sampling
# DEV_DASHBOARD_RETENTION_DAYS=7
# DEV_DASHBOARD_AUDIT_RETENTION_DAYS=180     # dashboard audit log (sign-ins and actions)
# ACTIVITY_RETENTION_DAYS=365              # activity log entries older than this are pruned (0 = keep)
# DEV_DASHBOARD_MAX_BODY_BYTES=65536
# DEV_DASHBOARD_REDACT_KEYS=              # extra sensitive keys (comma-separated)
# DEV_DASHBOARD_STORE=database

# ── MCP server (AI agents as connectors) ──
MCP_ENABLED=false                         # /mcp + /oauth/* + OAuth well-known docs; APP_URL must be the public https URL
# MCP_ACCESS_TOKEN_TTL=1h
# MCP_REFRESH_TOKEN_TTL=720h              # sliding: every refresh issues a new one
# MCP_OAUTH_CIMD_ENABLED=true             # any client connects with no registration (Client ID Metadata Document)
# MCP_OAUTH_ALLOWED_CLIENT_HOSTS=         # limit CIMD clients to these hosts, e.g. claude.ai (empty = any)
# MCP_OAUTH_SECRET_GRACE=24h              # a rotated client secret keeps working this long
# MCP_MAX_REQUEST_BYTES=1048576
# MCP_MAX_RESULT_BYTES=262144
# MCP_RATE_LIMIT=120                      # tool calls per minute per token

# Database backups
BACKUP_ENABLED=false                      # scheduler + dashboard triggers; CLI always available
BACKUP_NAME=                              # default: APP_NAME
BACKUP_DIR=backups                        # relative paths resolve under APP_STORAGE_DIR
BACKUP_DESTINATIONS=local                 # local is always included; add s3 for S3/R2/MinIO
# BACKUP_S3_PREFIX=backups                # object key prefix: <prefix>/<env>/<filename>
# BACKUP_PG_DUMP_PATH=pg_dump             # host binary; must match the server major version
# BACKUP_TIMEOUT=1h
# BACKUP_RUN_CRON=30 1 * * *
# BACKUP_CLEAN_CRON=30 2 * * *
# BACKUP_KEEP_ALL_DAYS=7
# BACKUP_KEEP_DAILY_DAYS=16
# BACKUP_KEEP_WEEKLY_WEEKS=8
# BACKUP_KEEP_MONTHLY_MONTHS=4
# BACKUP_KEEP_YEARLY_YEARS=2
# BACKUP_MAX_TOTAL_MB=0                   # 0 = unlimited
# BACKUP_MAX_AGE_HOURS=26
# BACKUP_INCLUDE_FILES=false
# BACKUP_FILES_PATHS=storage/public,storage/private
