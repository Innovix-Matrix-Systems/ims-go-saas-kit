---
// Starlight's search, plus a starting point: while the search box is empty
// the dialog shows popular pages and example searches instead of a blank
// panel. Typing hides it; Pagefind's results take over.
import Default from '@astrojs/starlight/components/Search.astro'

const groups = [
  {
    title: 'Start here',
    links: [
      { label: 'Quick start', hint: 'run it in five minutes', href: '/getting-started/quick-start/' },
      { label: 'Build your first module', hint: 'step-by-step tutorial', href: '/tutorial/first-module/' },
      { label: 'How it works', hint: 'the request flow', href: '/getting-started/how-it-works/' },
      { label: 'Project tour', hint: 'where everything lives', href: '/getting-started/project-tour/' },
    ],
  },
  {
    title: 'Building the API',
    links: [
      { label: 'Modules and the generator', hint: 'ims gen module', href: '/guides/modules/' },
      { label: 'Tenancy', hint: 'isolation, impersonation', href: '/guides/tenancy/' },
      { label: 'Permissions', hint: 'roles and route checks', href: '/guides/permissions/' },
      { label: 'Database and SQL', hint: 'migrations, sqlc', href: '/guides/database/' },
    ],
  },
  {
    title: 'Reference & operations',
    links: [
      { label: 'Configuration', hint: 'every .env variable', href: '/reference/configuration/' },
      { label: 'CLI', hint: 'every ims command', href: '/reference/cli/' },
      { label: 'Deploy', hint: 'systemd, one binary', href: '/operations/deploy/' },
      { label: 'Docker', hint: 'compose.yaml', href: '/operations/docker/' },
    ],
  },
]

const examples = ['X-Acting-Tenant', 'gen module', 'migrate', 'queue job', 'feature flag', 'backup', 'testkit']
---

<Default {...Astro.props}><slot /></Default>

<template id="ims-search-start">
  <div class="ims-search-start">
    <p class="ims-search-heading">Try searching for</p>
    <div class="ims-search-chips">
      {examples.map((query) => <button type="button" data-query={query}>{query}</button>)}
    </div>
    <div class="ims-search-groups">
      {
        groups.map((group) => (
          <section>
            <p class="ims-search-heading">{group.title}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>
                    <span class="label">{link.label}</span>
                    <span class="hint">{link.hint}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</template>

<script>
  // Mount the panel once into the search dialog, and show it only while the
  // query is empty. Pagefind creates its input lazily, so events are read
  // from the dialog rather than bound to the input.
  const mount = () => {
    const template = document.getElementById('ims-search-start') as HTMLTemplateElement | null
    const frame = document.querySelector('site-search .dialog-frame')
    if (!template || !frame || frame.querySelector('.ims-search-start')) return
    frame.append(template.content.cloneNode(true))
    const panel = frame.querySelector<HTMLElement>('.ims-search-start')!
    const dialog = frame.closest('dialog')!

    const query = () => frame.querySelector<HTMLInputElement>('input')?.value.trim() ?? ''
    const sync = () => panel.toggleAttribute('hidden', query() !== '')

    dialog.addEventListener('input', sync)
    // Pagefind's clear button empties the field a moment later, without an
    // input event; its results list re-renders when that happens, so watch
    // the dialog (and its open state) and re-check on every change.
    const observer = new MutationObserver(() => requestAnimationFrame(sync))
    observer.observe(dialog, { attributes: true, attributeFilter: ['open'], childList: true, subtree: true })

    panel.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-query]')
      const input = frame.querySelector<HTMLInputElement>('input')
      if (!chip || !input) return
      event.stopPropagation()
      input.value = chip.dataset.query ?? ''
      input.dispatchEvent(new Event('input', { bubbles: true }))
      input.focus()
    })
    sync()
  }

  mount()
  document.addEventListener('astro:page-load', mount)
</script>

<style is:global>
  .ims-search-start[hidden] {
    display: none;
  }
  .ims-search-start {
    padding: 0 1rem 1rem;
    overflow-y: auto;
  }
  .ims-search-heading {
    margin: 1rem 0 0.5rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .ims-search-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .ims-search-chips button {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    cursor: pointer;
  }
  .ims-search-chips button:hover,
  .ims-search-chips button:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .ims-search-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0 1.5rem;
  }
  .ims-search-groups ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .ims-search-groups a {
    display: flex;
    flex-direction: column;
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .ims-search-groups a:hover,
  .ims-search-groups a:focus-visible {
    background: var(--sl-color-gray-6);
  }
  .ims-search-groups .label {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .ims-search-groups .hint {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
</style>
