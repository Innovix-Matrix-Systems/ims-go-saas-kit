{
  "name": "ims-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8082",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:style": "node scripts/contrast.mjs",
    "openapi:gen": "openapi-typescript ../../api/openapi.yaml -o src/api/schema.d.ts",
    "openapi:check": "npm run openapi:gen && git diff --exit-code -- src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "cmdk": "1.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.168.47",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
